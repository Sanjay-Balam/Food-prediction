              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\projects\\food-predection\\apps\\api\\test_data\\hyderabad_demo\\sales.csv",
                  "description": ".csv or .json file"
                }
