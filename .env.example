# Copy to .env and fill in. Never commit .env.
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1
# xAI Grok:  LLM_BASE_URL=https://api.x.ai/v1
# OpenAI:    leave LLM_BASE_URL empty
LLM_API_KEY=
LLM_BASE_URL=
# Pick a current model name from your provider's model list. Groq: openai/gpt-oss-120b
LLM_MODEL=
# Only for reasoning models (gpt-oss, o-series): low keeps token use small. Leave empty otherwise.
LLM_REASONING_EFFORT=
